---
import { KIND_NAMES, KINDS } from '../consts';
import { getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
const recent = posts.slice(0, 8);
const links = [
	{ href: '/posts/', label: 'All posts', count: posts.length },
	...KIND_NAMES.map((kind) => ({
		href: `/${KINDS[kind].path}/`,
		label: KINDS[kind].plural,
		count: posts.filter((post) => post.data.kind === kind).length,
	})),
	{ href: '/tags/', label: 'Tags' },
];
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<aside class="sidebar">
	<nav aria-label="Main">
		<ul>
			{
				links.map(({ href, label, count }) => (
					<li>
						<a href={href} aria-current={current === href ? 'page' : undefined}>
							{label}
							{count !== undefined && <span class="count">{count}</span>}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<nav aria-labelledby="recent-posts">
		<h2 id="recent-posts">Recent posts</h2>
		<ul>
			{
				recent.map((post) => (
					<li>
						<a href={postUrl(post)} aria-current={current === postUrl(post) ? 'page' : undefined}>
							{post.data.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</aside>

<style>
	.sidebar {
		display: none;
	}
	@media (min-width: 64rem) {
		.sidebar {
			display: flex;
			flex-direction: column;
			gap: 1.75rem;
			position: sticky;
			top: calc(var(--header-height) + 1px);
			align-self: start;
			max-height: calc(100vh - var(--header-height) - 1px);
			overflow-y: auto;
			padding: 2rem 0 2rem 0.4rem;
			font-size: 0.95rem;
		}
	}
	h2 {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	a {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.3rem 0.6rem;
		border-radius: var(--radius);
		color: var(--muted);
		text-decoration: none;
		line-height: 1.35;
	}
	a:hover {
		color: var(--text);
		background: var(--accent-soft);
	}
	a[aria-current='page'] {
		color: var(--text);
		background: var(--accent-soft);
		font-weight: 700;
	}
	.count {
		font-size: 0.85em;
		color: var(--muted);
		font-weight: 400;
	}
	[aria-labelledby] a {
		font-size: 0.9rem;
	}
</style>
