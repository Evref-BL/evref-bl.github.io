---
import { postUrl, readingMinutes, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import KindLabel from './KindLabel.astro';
import TagList from './TagList.astro';

interface Props {
	post: Post;
	/** Leave the kind out, on a page that lists only one kind. */
	showKind?: boolean;
	/** Show "Part n", on a series page. */
	showPart?: boolean;
}

const { post, showKind = true, showPart = false } = Astro.props;
const { title, description, date, kind, tags, part, draft } = post.data;
---

<article>
	<p class="meta">
		{showKind && <KindLabel kind={kind} />}
		{showPart && <span>Part {part}</span>}
		<FormattedDate date={date} />
		<span>{readingMinutes(post)} min read</span>
		{draft && <span class="draft">Draft</span>}
	</p>
	<h2><a href={postUrl(post)}>{title}</a></h2>
	<p class="description">{description}</p>
	<TagList tags={tags} />
</article>

<style>
	article {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	.meta {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
	h2 {
		font-size: 1.3rem;
		margin: 0.2rem 0 0.35rem;
	}
	h2 a {
		color: var(--text);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.description {
		margin: 0 0 0.6rem;
		color: var(--muted);
	}
	.draft {
		color: var(--kind-news);
		font-weight: 700;
	}
</style>
