<button type="button" class="to-top" aria-label="Back to top">
	<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M12 19V5m-6 6 6-6 6 6"></path>
	</svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('.to-top')!;
	// Shown once the reader has scrolled a screen down.
	const update = () => button.classList.toggle('shown', window.scrollY > window.innerHeight);
	window.addEventListener('scroll', update, { passive: true });
	update();
	button.addEventListener('click', () => {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
	});
</script>

<style>
	.to-top {
		position: fixed;
		/* Beside the column of text, or near the edge of a screen too narrow to leave room. */
		right: max(1rem, env(safe-area-inset-right, 0px), calc(50vw - var(--measure) / 2 - 3.5rem));
		bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
		z-index: 10;
		display: inline-flex;
		padding: 0.65rem;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s,
			visibility 0.2s;
	}
	.to-top.shown {
		opacity: 1;
		visibility: visible;
	}
	.to-top:hover {
		color: var(--text);
		border-color: var(--accent);
	}
</style>
