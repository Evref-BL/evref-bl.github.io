---
import { KINDS, SITE_TITLE } from '../consts';
import SiteTools from './SiteTools.astro';

const links = [
	...Object.values(KINDS).map((kind) => ({ href: `/${kind.path}/`, label: kind.plural })),
	{ href: '/tags/', label: 'Tags' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<ul class="links">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<SiteTools />
	</nav>
</header>

<style>
	/* A wide screen has the sidebar instead. */
	@media (min-width: 64rem) {
		header {
			display: none;
		}
	}
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0 1rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 3.75rem;
	}
	.brand {
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
		font-size: 1rem;
		white-space: nowrap;
		padding: 1.1rem 0;
		border-bottom: 2px solid transparent;
	}
	.links a:hover,
	.links a[aria-current='page'] {
		color: var(--text);
	}
	.links a[aria-current='page'] {
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			gap: 0 1rem;
			padding-top: 0.5rem;
		}
		.brand {
			flex: 1;
		}
		.links {
			order: 3;
			flex-basis: 100%;
		}
		.links a {
			padding: 0.6rem 0;
		}
	}
</style>
