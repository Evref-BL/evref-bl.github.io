---
import { GITHUB_URL, KINDS, SITE_TITLE } from '../consts';

const links = [
	...Object.values(KINDS).map((kind) => ({ href: `/${kind.path}/`, label: kind.plural })),
	{ href: '/tags/', label: 'Tags' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<ul class="links">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="tools">
			<a href="/search/" class="icon" aria-current={isCurrent('/search/') ? 'page' : undefined}>
				<span class="sr-only">Search</span>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						d="M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Zm5.3-2.2L21 21"></path>
				</svg>
			</a>
			<button type="button" class="icon theme-toggle" aria-label="Switch between light and dark">
				<svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
					</g>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linejoin="round"
						d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
				</svg>
			</button>
			<a href={GITHUB_URL} class="icon">
				<span class="sr-only">Evref-BL on GitHub</span>
				<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
		button.addEventListener('click', () => {
			const root = document.documentElement;
			const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = theme;
			try {
				localStorage.setItem('theme', theme);
			} catch {}
			document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
		});
	}
</script>

<style>
	header {
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0 1rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		min-height: 3.75rem;
	}
	.brand {
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}
	.links {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
		font-size: 1rem;
		white-space: nowrap;
		padding: 1.1rem 0;
		border-bottom: 2px solid transparent;
	}
	.links a:hover,
	.links a[aria-current='page'] {
		color: var(--text);
	}
	.links a[aria-current='page'] {
		border-bottom-color: var(--accent);
	}
	.tools {
		display: flex;
		gap: 0.25rem;
		align-items: center;
	}
	.icon {
		display: inline-flex;
		padding: 0.5rem;
		border: none;
		background: none;
		color: var(--muted);
		cursor: pointer;
		border-radius: var(--radius);
	}
	.icon:hover,
	.icon[aria-current='page'] {
		color: var(--text);
		background: var(--accent-soft);
	}
	:global([data-theme='dark']) .sun,
	:global([data-theme='light']) .moon {
		display: none;
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			gap: 0 1rem;
			padding-top: 0.5rem;
		}
		.brand {
			flex: 1;
		}
		.links {
			order: 3;
			flex-basis: 100%;
		}
		.links a {
			padding: 0.6rem 0;
		}
	}
</style>
