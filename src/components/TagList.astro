---
interface Props {
	tags: string[];
	/** Counts to show next to each tag, as on the tag index. */
	counts?: Map<string, number>;
}

const { tags, counts } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${tag}/`}>
						#{tag}
						{counts && <span class="count">{counts.get(tag)}</span>}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a {
		display: inline-block;
		font-size: 0.85rem;
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.count {
		color: var(--muted);
		margin-left: 0.3rem;
	}
</style>
