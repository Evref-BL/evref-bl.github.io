---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { countTags, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	return countTags(await getPosts()).map(([tag]) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = await getPosts((post) => post.data.tags.includes(tag));
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
	<h1>#{tag}</h1>
	<p class="page-intro">
		{posts.length} {posts.length === 1 ? 'post' : 'posts'}, newest first. <a href="/tags/">All tags</a>
	</p>
	<PostList posts={posts} />
</Base>
